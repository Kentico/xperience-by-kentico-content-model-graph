# Auto detect text files and normalize them to LF, in the repository and in the
# working tree alike.
#
# eol=lf is deliberate and load bearing. .editorconfig sets end_of_line = lf for
# C# and CI gates every build on `dotnet format --verify-no-changes`, so a CRLF
# working tree fails the build. Without eol=lf that is exactly what a developer
# with core.autocrlf=true gets the moment git touches a file - a checkout, a
# branch switch, a stash pop - and the failure looks like thousands of unrelated
# whitespace errors.

*                   text=auto eol=lf

*.cs                text diff=csharp
*.cshtml            text diff=html

*.sln               text
*.slnx              text
*.csproj            text
*.vcproj            text
*.sqlproj           text

*.xproj             text
*.props             text
*.filters           text
*.vcxitems          text

*.yaml              text
*.yml               text

*.css               text diff=css
*.html              text diff=html
*.js                text
*.jsx               text
*.ts                text
*.tsx               text

package.json        text
package-lock.json   text -diff

*.sql               linguist-detectable=true
*.sql               linguist-language=sql
.vscode/*.json      linguist-language=JSON-with-Comments
tsconfig.json       linguist-language=JSON-with-Comments

*.webm              binary
*.mp4               binary

*.svg               text
*.ico               binary
*.gif               binary
*.pdf               binary
*.png               binary
*.jpg               binary
*.jpeg              binary
*.webp              binary

*.woff              binary
*.woff2             binary
