@using DancingGoat.Models

@model CheckoutViewModel

@{
    ViewBag.Title = Model.Step == CheckoutStep.OrderConfirmation
        ? HtmlLocalizer["Order confirmation"].Value
        : HtmlLocalizer["Customer details"].Value;
}

@if (Model.Step == CheckoutStep.CheckoutCustomer)
{
    <partial name="_CheckoutCustomer" model="Model" />
}
else if (Model.Step == CheckoutStep.OrderConfirmation)
{
    <partial name="_OrderConfirmation" model="Model" />
}

@section scripts {
    @if (Model.Step == CheckoutStep.CheckoutCustomer)
    {
        <script src="~/Scripts/checkoutSummary.js" defer></script>
        <script src="~/Scripts/checkoutAddress.js" defer></script>
    }
}
