{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/src/Kentico.Xperience.ContentModelGraph/Client"
      },
      "group": "build",
      "problemMatcher": [],
      "label": "npm: install - Admin/Client",
      "detail": "install dependencies from package"
    },
    {
      "type": "dotnet",
      "task": "build",
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "label": "dotnet: build"
    },
    {
      "type": "shell",
      "command": "dotnet",
      "args": [
        "format",
        "Kentico.Xperience.ContentModelGraph.slnx",
        "--exclude",
        "./examples/**"
      ],
      "problemMatcher": ["$msCompile"],
      "group": "none",
      "label": "dotnet: format"
    },
    {
      "type": "dotnet",
      "task": "clean",
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "label": "dotnet: clean"
    },
    {
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/src/Kentico.Xperience.ContentModelGraph/Client"
      },
      "group": "build",
      "problemMatcher": [],
      "label": "npm: build - Admin/Client",
      "detail": "webpack --mode=production"
    },
    {
      "type": "process",
      "command": "npm",
      "args": ["run", "build:dev"],
      "options": {
        "cwd": "${workspaceFolder}/src/Kentico.Xperience.ContentModelGraph/Client"
      },
      "group": "build",
      "problemMatcher": [],
      "label": "npm: build:dev - Admin/Client",
      "detail": "webpack --mode=development"
    },
    {
      "type": "process",
      "command": "npm",
      "args": ["run", "start"],
      "options": {
        "cwd": "${workspaceFolder}/src/Kentico.Xperience.ContentModelGraph/Client"
      },
      "problemMatcher": [],
      "label": "npm: watch - Admin/Client",
      "detail": "webpack serve --mode development"
    },
    {
      "label": "dotnet: watch DancingGoat",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/examples/DancingGoat/DancingGoat.csproj"
      ],
      "options": {
        "env": {
          "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
        }
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
